[Unit]
Description=VITALS personal health API
After=network.target mysqld.service

[Service]
User=vitals
Group=vitals
WorkingDirectory=/www/wwwroot/health.baihejie.cn
EnvironmentFile=/www/server/vitals/private/health.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/www/wwwroot/health.baihejie.cn/.venv/bin/gunicorn --bind 127.0.0.1:8931 --workers 1 --threads 4 --timeout 60 --access-logfile - --error-logfile - cloud.wsgi:app
Restart=on-failure
RestartSec=5
MemoryMax=512M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
