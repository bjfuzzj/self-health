# Load through your service manager, not into public webroot. Replace all placeholders.
HEALTH_SECRET_KEY=replace-with-at-least-32-random-bytes
HEALTH_DB_HOST=127.0.0.1
HEALTH_DB_PORT=3306
HEALTH_DB_NAME=vitals_health
HEALTH_DB_USER=vitals_health
HEALTH_DB_PASSWORD=replace-me
HEALTH_ATTACHMENT_DIR=/var/lib/self-health/attachments
# Used only by init or set-password; remove from service environment afterward.
# HEALTH_OWNER_PASSWORD=
# Optional OSS; all four values are required. Bucket ACL must already be private.
# HEALTH_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# HEALTH_OSS_BUCKET=
# HEALTH_OSS_ACCESS_KEY_ID=
# HEALTH_OSS_ACCESS_KEY_SECRET=
# HEALTH_OSS_KEY_PREFIX=vitals/attachments
# Reserved for the future model adapter. Setting these does not enable recognition yet.
# HEALTH_MODEL_BASE_URL=
# HEALTH_MODEL_API_KEY=
# HEALTH_MODEL_NAME=
